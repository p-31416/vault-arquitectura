{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    }
  },
  "mcp": {
    "comfyui": {
      "type": "local",
      "command": ["npx", "-y", "comfyui-mcp"],
      "enabled": true,
      "env": {
        "COMFYUI_URL": "http://127.0.0.1:8188"
      }
    },
    "fathom": {
      "type": "remote",
      "url": "https://api.fathom.ai/mcp",
      "enabled": true,
      "oauth": {}
    }
  }
}
