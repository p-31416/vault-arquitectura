{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "comfyui": {
      "type": "local",
      "command": ["npx", "-y", "comfyui-mcp"],
      "enabled": true,
      "environment": {
        "COMFYUI_URL": "http://127.0.0.1:8188"
      }
    },
    "n8n-mcp": {
      "type": "remote",
      "url": "https://n8n.pitau.tech/mcp-server/http",
      "headers": {
        "Authorization": "Bearer {env:N8N_MCP_TOKEN}"
      },
      "enabled": true
    },
    "fathom": {
      "type": "remote",
      "url": "https://api.fathom.ai/mcp",
      "enabled": true,
      "oauth": {}
    },
    "fathom-proyectopi": {
      "type": "local",
      "command": ["npx", "-y", "@luminarylane/fathom-mcp-server"],
      "environment": { "FATHOM_API_KEY": "{env:FATHOM_API_KEY_PROYECTOPI}" },
      "enabled": true,
      "timeout": 30000
    },
    "leantime": {
      "type": "remote",
      "url": "https://pitautech-leantime.3nq4ow.easypanel.host/mcp",
      "headers": {
        "x-api-key": "{env:LEANTIME_TOKEN}"
      },
      "enabled": true,
      "timeout": 30000
    },
    "autodesk-help": {
      "type": "remote",
      "url": "https://developer.api.autodesk.com/knowledge/public/v1/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "autocad": {
      "type": "local",
      "command": ["P:/00-repos/proyecto-pi/tools/autocad-mcp/.venv/Scripts/autocad-mcp.exe"],
      "environment": { "ACAD_MCP_OUTPUT_ROOT": "P:/00-repos/proyecto-pi/vault-arquitectura/activos/caddy-salidas" },
      "enabled": true,
      "timeout": 20000
    },
    "rhino": {
      "type": "local",
      "command": ["C:/Users/Solch16/AppData/Local/Programs/Python/Python312/Scripts/uvx.exe", "--with", "mcp<2", "reer-rhino-mcp"],
      "enabled": true,
      "timeout": 60000
    }
  }
}
